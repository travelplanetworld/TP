# Recommended for most uses (Connection pooling via PgBouncer)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-flat-surf-b36t7avn-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require"

# Direct unpooled connection for Prisma migrations and schema push
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-flat-surf-b36t7avn.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:YOUR_PASSWORD@ep-flat-surf-b36t7avn.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Parameters for constructing your own connection string
PGHOST="ep-flat-surf-b36t7avn-pooler.c-4.ap-southeast-1.aws.neon.tech"
PGHOST_UNPOOLED="ep-flat-surf-b36t7avn.c-4.ap-southeast-1.aws.neon.tech"
PGUSER="neondb_owner"
PGDATABASE="neondb"
PGPASSWORD="YOUR_PASSWORD"
